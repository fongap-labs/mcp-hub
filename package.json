{
  "name": "mcp-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Modular Cloudflare Workers MCP gateway with service-scoped admin and OAuth resources",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mcp-hub --local",
    "db:migrate:remote": "wrangler d1 migrations apply mcp-hub --remote",
    "test": "node --experimental-strip-types --experimental-sqlite --test tests/*.test.js",
    "check": "npm run typecheck",
    "cf:db:create": "node scripts/with-secondary-cloudflare.mjs d1 create mcp-hub",
    "cf:migrate": "node scripts/with-secondary-cloudflare.mjs d1 migrations apply mcp-hub --remote",
    "cf:deploy": "node scripts/with-secondary-cloudflare.mjs deploy",
    "cf:secrets": "node scripts/with-secondary-cloudflare.mjs secret bulk .secrets.json",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "validate": "npm run check && npm test",
    "check:deploy": "node scripts/deployment-config.mjs preflight"
  },
  "devDependencies": {
    "wrangler": "^4.44.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "author": "Fongap Labs"
}
